{
  "name": "watchtogether-desktop",
  "version": "0.10.2",
  "private": true,
  "description": "Electron-обёртка WatchTogether",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "node build-installer.cjs"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.watchtogether.app",
    "productName": "WatchTogether",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "proxy-scan.cjs",
      "package.json",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "../server/dist",
        "to": "server/dist"
      },
      {
        "from": "../server/package.json",
        "to": "server/package.json"
      },
      {
        "from": "../server/node_modules",
        "to": "server/node_modules"
      },
      {
        "from": "../app/dist",
        "to": "client"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "WatchTogether",
      "createDesktopShortcut": true
    },
    "directories": {
      "output": "../release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ssh2": "^1.17.0"
  }
}
